# Copy to .env and fill in. Every variable is optional for a local run unless noted. Never commit .env.

# ---- routing (route API / aggregator)
# Base URL of the route API, e.g. https://<host>/v1/ . No default: empty = routing disabled (quotes/builds answer routing_unavailable).
ROUTE_API_URL=
# Route API key (server-side only). Empty = public rate limits.
ROUTE_API_KEY=
# HTTP header name the route API expects the key in. Empty = the key is not sent.
ROUTE_API_KEY_HEADER=
# Optional regex of names scrubbed from every public response (the ROUTE_API_URL host is always added).
ROUTE_HIDDEN_NAMES=
# Optional regex of token names hidden from the network token list.
TOKEN_HIDDEN_NAMES=
# Optional token-metadata endpoint with {} for the token address (JSON: address + artwork/image). Empty = off.
LAUNCH_META_URL=

# ---- sign-in (Privy)
# Privy app id: enables wallet sign-in (required in production).
PRIVY_APP_ID=
# Privy app secret: wallet lookup for an access token (required in production unless RHDEX_PRIVY_IDTOKEN=1).
PRIVY_APP_SECRET=
# Optional Privy verification key (PEM); set = no JWKS fetch.
PRIVY_VERIFICATION_KEY=
# 1 = the page sends the Privy identity token instead (lets production run without PRIVY_APP_SECRET).
RHDEX_PRIVY_IDTOKEN=

# ---- site and runtime
# Product name (default Skiff).
BRAND_NAME=
# Public https:// address; setting it marks production (guard.py).
RHDEX_SITE=
# prod = production checks on start (guard.py).
RHDEX_ENV=
# SQLite path (default data/rhdex.db).
RHDEX_DB=
# Data directory (default data/).
RHDEX_DATA=
# 1 = read the client IP from the platform proxy header.
RHDEX_TRUST_PROXY=
# Log level (default INFO).
RHDEX_LOG=
# Max concurrent quote jobs (default 24).
RHDEX_MAX_QUOTES=
# Port for run.sh / the container (default 8850 locally, 8080 in the image).
PORT=
# Token that unlocks the full /healthz body via the x-health-token header.
HEALTHZ_TOKEN=
# Must stay unset in production (one worker only).
WEB_CONCURRENCY=
# Robinhood Chain RPC and fallback (defaults: the official RPC and publicnode).
RH_RPC=
RH_RPC_FALLBACK=
# Path to a copy-strings JSON (default engine/copy-strings.json).
COPY_STRINGS=

# ---- local development only (refused in production)
# 1 = X-Dev-Wallet sign-in from 127.0.0.1 (run.sh sets it).
DEV=
# Serve recorded quotes instead of live ones.
QUOTE_REPLAY=

# ---- background workers (default on; 0 = off)
BOARD=
TRADES=
NTOKENS=
REACH=
# Pause between route API catalog calls in seconds (default 1.5).
REACH_PAUSE_S=
# Tx fetches per quote without a key (default 3).
TX_CAP_NOKEY=

# ---- features and thresholds
# 1 = limit orders (not built; default 0).
LIMITS_ENABLED=
# 1 = big-trade alerts (default 0).
ALERTS_ENABLED=
# Board hero minimum gain in USD (default 50).
HERO_MIN_USD=
# Gap in % below the best route that marks pools as too thin (default 3).
VS_POOL_MAX_GAP_PCT=

# ---- Telegram (off unless TG_ENABLED=1)
TG_ENABLED=
# Telegram bot token; empty = fake transport.
TG_BOT_TOKEN=
# Bot username (default <brand>_bot).
TG_BOT_NAME=

# ---- token page (/token, Vault)
# 1 = serve /token and /api/vault*.
TOKEN_PAGE=
# Token ticker without $.
TOKEN_TICKER=
# Token contract on Robinhood Chain (4663).
TOKEN_CA=
# Public vault wallet on 4663.
VAULT_ADDRESS=
# Optional ISO UTC of the first drop.
VAULT_FIRST_DROP=

# Platform-injected (do not set by hand): RAILWAY_* markers, RAILWAY_VOLUME_MOUNT_PATH, FLY_APP_NAME.
